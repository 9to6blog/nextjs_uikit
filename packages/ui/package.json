{
  "name": "@9to6/ui",
  "version": "0.1.2",
  "description": "Composable React and Next.js components with a shared motion language.",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./blocks.css": "./dist/blocks.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "next": ">=16 <17",
    "react": ">=19.2 <20",
    "react-dom": ">=19.2 <20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-fade": "8.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "radix-ui": "1.6.7",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.13.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "license": "UNLICENSED",
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
