{
  "name": "@9to6/ui",
  "version": "0.1.0",
  "description": "Thoughtful, accessible components with a shared motion language for Next.js.",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json \u0026\u0026 node ../../scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "next": "\u003e=16 \u003c17",
    "react": "\u003e=19.2 \u003c20",
    "react-dom": "\u003e=19.2 \u003c20"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "radix-ui": "1.6.7",
    "react-day-picker": "^10.0.1",
    "react-resizable-panels": "^4.13.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "license": "UNLICENSED"
}
